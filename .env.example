# IssueScout — environment variable reference.
# Copy to .env (never commit .env itself) and fill in real values.
# Every name below is read in lib/server/config.ts or
# lib/server/db/supabaseClient.ts — grep-verified, not hand-maintained
# from memory. No real secrets live in this file.

# ---- Approved repository (fixed, Build Spec §4) ----
APPROVED_REPO=calcom/cal.diy

# ---- D2: model provider — CONFIRM BEFORE SHIPPING ----
# "anthropic" or "groq". Anthropic is the primary, fully-tested path;
# Groq is a best-effort local/cost-free swap, not required to pass the
# acceptance tests (see README "Limits & known gaps").
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-placeholder
ANTHROPIC_MODEL=claude-sonnet-4-5
GROQ_API_KEY=gsk-placeholder
GROQ_MODEL=llama-3.3-70b-versatile

# ---- D3: GitHub read access — CONFIRM BEFORE SHIPPING ----
# A read-only, fine-grained PAT scoped to APPROVED_REPO only. Without
# one, unauthenticated GitHub requests are limited to 60/hr.
GITHUB_READ_TOKEN=github_pat_placeholder

# (A write-scoped GitHub token is intentionally absent from this file —
# see the README's "What this build does not do" section for why.)

# ---- D6/D7/D8: harness constants — CONFIRM BEFORE SHIPPING with Ivaylo ----
ISSUE_MAX_CHARS=20000
MAX_OUTPUT_TOKENS=4000
RUNS_PER_USER_PER_HOUR=10

# ---- D9: Firebase confirmed; restrict membership to the pair ----
# ALLOWED_USER_EMAILS is a comma-separated allowlist — the
# app MUST NOT be open to the public (PRD §9, fixed requirement).
AUTH_PROVIDER=firebase
ALLOWED_USER_EMAILS=maintainer-a@example.com,maintainer-b@example.com

# ---- CORS (PRD §9 finding #5 — hard requirement, not a placeholder) ----
# Comma-separated explicit allowlist. No wildcard, no default-allow.
CORS_ALLOWED_ORIGINS=https://issuescout.example.com

# ---- Database (Supabase Postgres, service-role key, backend only) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# Firebase Admin local credentials: absolute path outside this repository.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/service-account.json

# ---- Browser sign-in (Firebase web app settings; public, not Admin credentials) ----
# Enable Google sign-in in this same Firebase project and authorize your app domain.
# Never prefix service-role keys, model keys or Admin credentials with NEXT_PUBLIC_.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Display hint only; APPROVED_REPO on the backend remains authoritative.
NEXT_PUBLIC_APPROVED_REPO=calcom/cal.diy
